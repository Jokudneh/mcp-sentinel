{
  "name": "mcp-sentinel",
  "version": "0.2.0",
  "description": "Zero-dependency stdio firewall and flight recorder for Model Context Protocol (MCP) servers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jokudneh/mcp-sentinel.git"
  },
  "homepage": "https://github.com/Jokudneh/mcp-sentinel#readme",
  "bugs": {
    "url": "https://github.com/Jokudneh/mcp-sentinel/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "firewall",
    "cli",
    "ai-agents",
    "json-rpc"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mcp-sentinel": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "bench": "npm run build && node scripts/bench.mjs",
    "clean": "node -e \"import('node:fs').then(fs => { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('dist-test', { recursive: true, force: true }); })\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
